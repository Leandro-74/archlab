# =============================================================================
#  archlab - configuracao de exemplo
#
#  Uso:
#    su -c "sh archlab.sh install --config /sdcard/Download/archlab.env --yes"
#
#  O arquivo e um shell script (VAR=valor). Ele e carregado ANTES das flags, ou
#  seja: defaults < config < flags de linha de comando.
#  Valores com espacos devem ficar entre aspas simples ou duplas.
#
#  O config gerado pelo instalador fica em /data/local/archlab/config.env
#  (ou $BASE/config.env). Segredos NAO sao gravados por padrao.
# =============================================================================


# ------------------------------- BASE ---------------------------------------
# Pasta de trabalho (rootfs, downloads, estado, log).
# Pode tambem ser escolhida com --base ou com a variavel de ambiente
# ARCHLAB_BASE (essa precisa ser definida fora do config, antes de carrega-lo).
#BASE=/data/local/archlab

# ------------------------------- ROOTFS -------------------------------------
# Arquitetura do rootfs. "auto" usa a ABI do Android (aarch64/armv7).
# x86/x86_64 nao sao suportados.
ARCH=auto

# Tarball local do Arch Linux ARM (vazio = baixar do mirror).
ROOTFS_TARBALL=

# URL direta do tarball (vazio = montar a partir do MIRROR + ARCH).
ROOTFS_URL=

# ------------------------------- MIRRORS ------------------------------------
# Raiz do mirror, SEM $arch/$repo e sem /os no final.
MIRROR=http://mirror.archlinuxarm.org
MIRROR_FALLBACKS="http://fl.us.mirror.archlinuxarm.org http://ca.us.mirror.archlinuxarm.org"

# ------------------------------- USUARIO ------------------------------------
LAB_USER=lab
LAB_HOST=archlab
LAB_TZ=America/Sao_Paulo
LAB_LANG=en_US.UTF-8

# Senha do usuario/root. Vazio = gerar senha aleatoria (salva em credentials).
# Evite deixar senha em texto puro aqui; prefira --password no comando.
LAB_PASSWORD=

# ------------------------------- SSH ----------------------------------------
ENABLE_SSH=1
SSH_PORT=2222
# yes = aceita senha; no = somente chave (exige SSH_PUBKEY_FILE)
SSH_PASSWORD_AUTH=yes
# Caminho de uma chave publica acessivel no Android (ex.: /sdcard/Download/id_ed25519.pub).
# Se vazio, o instalador procura em $BASE/dl por id_ed25519.pub, id_ecdsa.pub,
# id_rsa.pub ou authorized_keys.
SSH_PUBKEY_FILE=
# Lista de usuarios permitidos no sshd (vazio = qualquer usuario valido).
SSH_ALLOW_USERS=

# ------------------------------- PACOTES ------------------------------------
# minimal | dev | server | custom
PROFILE=minimal
# Pacotes extras alem do perfil (separados por espaco).
# O perfil ja inclui sudo e ca-certificates; openssh entra se ENABLE_SSH=1.
PACKAGES=

# ------------------------------- TAILSCALE ----------------------------------
ENABLE_TAILSCALE=0
# Vazio = usa LAB_HOST.
TS_HOSTNAME=
# Habilita "tailscale ssh" dentro do chroot.
TS_SSH=0
# Chave de autenticacao (tskey-auth-...). Nao e salva no config gerado
# a menos que --save-secrets seja usado. Descomente para uso automatizado.
#TS_AUTHKEY=
# Argumentos extras para "tailscaled" (ex.: --advertise-routes=...).
TS_ARGS=

# ------------------------------- INTEGRACAO ANDROID -------------------------
# Cria /data/adb/service.d/archlab.sh para subir o lab no boot.
AUTOSTART=0
# Segundos de espera antes de subir no boot.
BOOT_DELAY=30
# Mantem wakelock enquanto o lab estiver rodando.
WAKELOCK=0
# Monta /sdcard dentro do chroot em /mnt/sdcard.
BIND_SDCARD=0
# Bind mounts extras no formato origem:destino_absoluto (separados por espaco).
EXTRA_BINDS=
# Servidores DNS (vazio = detecta via getprop, senao 1.1.1.1 8.8.8.8).
DNS_SERVERS=
# auto | 1 (permissive) | 0 (nao mexer)
SELINUX_PERMISSIVE=auto

# ------------------------------- AVANCADO -----------------------------------
# Espaco livre minimo/recomendado em MB antes de instalar.
MIN_FREE_MB=4096
RECOMMENDED_FREE_MB=6144
# sudo sem senha para o usuario do lab. 1 = conveniente, 0 = seguro.
SUDO_NOPASSWD=0
# Bloqueia login de root por senha (root continua acessivel via "archlab shell").
LOCK_ROOT=1
# Limpa o cache do pacman ao final da instalacao.
CLEAN_CACHE=1
# Mantem o tarball baixado em $BASE/dl para reinstalacoes.
KEEP_TARBALL=1

# ------------------------------- COMPORTAMENTO ------------------------------
# Nao perguntar nada (equivalente a --yes). Cuidado: pode apagar um rootfs existente.
ASSUME_YES=0
# 1 = apenas mostra o que seria feito (equivalente a --dry-run).
DRY_RUN=0
# auto | 1 | 0. auto = interativo somente se houver terminal.
INTERACTIVE=auto
# Desativa cores.
NO_COLOR=0
# Tamanho maximo do log em KB antes de rotacionar (0 = nao rotacionar).
LOG_MAX_KB=5120
